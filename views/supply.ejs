<%- include('partials/header') %>

<div class="container mt-5">
  <h2 class="mb-4 text-center"><%= title %></h2>

  <!-- Display error if any -->
  <% if (error) { %>
    <div class="alert alert-danger text-center"><%= error %></div>
  <% } else { %>
    <table class="table table-striped">
      <thead class="table-dark">
        <tr>
          <th>Resource</th>
          <th>Quantity</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% supplies.forEach(s => { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.quantity %></td>
            <td>
              <span class="<%= s.quantity > 20 ? 'text-success' : s.quantity > 5 ? 'text-warning' : 'text-danger' %>">
                <%= s.quantity > 20 ? 'Sufficient' : s.quantity > 5 ? 'Low' : 'Critical' %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

