<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <h2 class="text-center mb-4">MediTrack - Hospital Signup</h2>
  
  <form action="/signup" method="POST" class="mx-auto" style="max-width: 400px;">
    
    <div class="mb-3">
      <label for="name" class="form-label">Username</label>
      <input type="text" id="name" name="username" class="form-control" required placeholder="Enter your username">
    </div>
    
    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" name="email" class="form-control" required placeholder="Enter your email">
    </div>
    
    <div class="mb-3">
      <label for="hospitalId" class="form-label">Hospital ID / Registration Number</label>
      <input type="text" id="hospitalId" name="hospitalId" class="form-control" required placeholder="Enter your hospital ID">
    </div>
    
    <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input type="password" id="password" name="password" class="form-control" required placeholder="Enter a secure password">
    </div>
    
    <button type="submit" class="btn btn-primary w-100">Sign Up</button>
    
    <p class="mt-3 text-center">
      Already have an account? <a href="/login">Login here</a>
    </p>
  </form>
</div>
