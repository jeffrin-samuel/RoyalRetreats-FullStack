<%- include('partials/header') %>

<div class="container mt-5">
  <h2 class="mb-4 text-center">Hospital Resource Dashboard</h2>

  <div class="row">
    <% hospitals.forEach(hospital => { %>
      <div class="col-md-4 mb-4">
        <div class="card text-center shadow-sm">
          <div class="card-body">
            <h5 class="card-title"><%= hospital.name %></h5>

            <!-- Beds -->
            <p class="card-text">
              Beds: 
              <span class="<%= hospital.beds > 10 ? 'text-success' : hospital.beds > 5 ? 'text-warning' : 'text-danger' %>">
                <%= hospital.beds %>
              </span>
            </p>

            <!-- Oxygen -->
            <p class="card-text">
              Oxygen Cylinders: 
              <span class="<%= hospital.oxygen > 10 ? 'text-success' : hospital.oxygen > 5 ? 'text-warning' : 'text-danger' %>">
                <%= hospital.oxygen %>
              </span>
            </p>

            <!-- Doctors -->
            <p class="card-text">
              Doctors Available: 
              <span class="<%= hospital.doctors > 5 ? 'text-success' : hospital.doctors > 2 ? 'text-warning' : 'text-danger' %>">
                <%= hospital.doctors %>
              </span>
            </p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<%- include('partials/footer') %>